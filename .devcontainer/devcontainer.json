{
  "name": "de-pipeline-starter",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  "postCreateCommand": "pip install uv && uv sync",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Mock API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
